# tests/bootstrap.php sets the time zone; the php section would need nette/bootstrap

http:
    frames: null

session:
    autoStart: false

application:
    scanDirs: false
    mapping:
        *: GPWebPay\Tests\*Presenter

services:
    router: Nette\Application\Routers\SimpleRouter

    # nette/application 3.3 creates only presenters registered as services
    - GPWebPay\Tests\TestPresenter

    cacheStorage:
        class: Nette\Caching\Storages\MemoryStorage
